# --- Routing (Traefik on the shared wayfarer-net) ---
# sslip.io gives working DNS + TLS with zero setup. Swap for the real domain later.
SITE_HOST=gitoutoftown.129-153-49-190.sslip.io

# --- Postgres ---
POSTGRES_USER=graffiti
POSTGRES_PASSWORD=change-me
POSTGRES_DB=graffiti

# --- App ---
# In-cluster the host is got-db; locally it is localhost via the published port.
DATABASE_URL=postgres://graffiti:change-me@localhost:5432/graffiti
UPLOAD_DIR=./.uploads
ADMIN_DELETE_SECRET=change-me

# --- Third party ---
REPLICATE_API_TOKEN=
# NOTE: NEXT_PUBLIC_* is inlined at BUILD time — it is a Docker build arg, not runtime env.
# Changing it requires a rebuild, not a restart.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
