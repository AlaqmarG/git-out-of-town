# --- Postgres (compose) ---
POSTGRES_USER=graffiti
POSTGRES_PASSWORD=change-me
POSTGRES_DB=graffiti

# --- App ---
# Local dev points at the compose db via the published port; in-cluster it is db:5432
DATABASE_URL=postgres://graffiti:change-me@localhost:5432/graffiti
UPLOAD_DIR=./.uploads
ADMIN_DELETE_SECRET=change-me

# --- Third party ---
REPLICATE_API_TOKEN=
# NOTE: NEXT_PUBLIC_* is inlined at BUILD time — it must be a Docker build arg, not runtime env.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Deploy (Caddy) ---
SITE_DOMAIN=gitoutoftown.example.com
